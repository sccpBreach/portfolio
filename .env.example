# Resend API Key — daftar gratis di https://resend.com
# Copy file ini ke .env.local dan isi API key-nya
RESEND_API_KEY=re_xxxxxxxxxxxx

# Upstash Redis — daftar gratis di https://upstash.com
# untuk rate limiter (wajib di production/serverless)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# Site URL — ganti dengan domain Vercel atau custom domain kamu
# Biarkan kosong kalau pake VERCEL_URL bawaan Vercel
NEXT_PUBLIC_SITE_URL=https://portfolio-one-mauve-58.vercel.app
